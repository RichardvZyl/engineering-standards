#!/bin/sh
# no-branch mode: after checkout, refuse (exit 1) when not on the default branch.
set -eu

mode=${BRANCH_GUARD_MODE:-}
if [ -z "$mode" ] && command -v git >/dev/null 2>&1; then
    mode=$(git config --get branchGuard.mode 2>/dev/null || true)
fi
mode=$(printf '%s' "$mode" | tr '[:upper:]' '[:lower:]')
case $mode in
    no-branch|nobranch) ;;
    *) exit 0 ;;
esac

DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
guard="$DIR/Invoke-BranchLocationGuard.ps1"
[ -f "$guard" ] || { echo "BRANCH LOCATION GUARD: guard script missing; refusing." >&2; exit 1; }

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File "$guard" -Hook post-checkout -Mode no-branch </dev/null || exit 1
elif command -v powershell.exe >/dev/null 2>&1; then
    gpath=$(cygpath -w "$guard" 2>/dev/null || echo "$guard")
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$gpath" -Hook post-checkout -Mode no-branch </dev/null || exit 1
else
    BRANCH_GUARD_MODE=no-branch sh "$DIR/branch-location-guard.sh" || exit 1
fi
exit 0
