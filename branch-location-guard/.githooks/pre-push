#!/bin/sh
# branch-location-guard: refuse push unless location (or no-branch) policy passes.
# Fail-closed stdin: git feeds ref lines on stdin; if stdin cannot be consumed, refuse.
# Inactive until core.hooksPath=.githooks is set locally.
set -eu
DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)

# Consume stdin from git. Empty stdin is allowed (no refs). An IO failure is not —
# refuse rather than pushing while blind.
if ! stdin_data=$(cat 2>/dev/null); then
    printf 'branch-location-guard: REFUSED. cannot read pre-push stdin (fail closed).\n' >&2
    exit 1
fi
: "${stdin_data}"

run_ps1() {
    exe=$1
    shift
    "$exe" -NoProfile -File "$DIR/Invoke-BranchLocationGuard.ps1" "$@"
}

if command -v pwsh >/dev/null 2>&1; then
    run_ps1 pwsh || exit $?
elif command -v powershell.exe >/dev/null 2>&1; then
    run_ps1 powershell.exe || exit $?
elif command -v pwsh.exe >/dev/null 2>&1; then
    run_ps1 pwsh.exe || exit $?
else
    sh "$DIR/branch-location-guard.sh" || exit $?
fi
exit 0
