#!/bin/sh
# Branch-location guard (pre-push). Fails closed: if the guard cannot run, the operation is refused.
# Inactive until core.hooksPath=.githooks is set locally.
set -eu
DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
guard="$DIR/Invoke-BranchLocationGuard.ps1"
[ -f "$guard" ] || { echo "BRANCH LOCATION GUARD: guard script missing; refusing." >&2; exit 1; }

# Original fail-closed stdin consume (git feeds ref lines on stdin).
cat >/dev/null

run_ps1() {
    exe=$1
    shift
    "$exe" -NoProfile -ExecutionPolicy Bypass -File "$guard" -Hook pre-push "$@" </dev/null || exit 1
}

if command -v pwsh >/dev/null 2>&1; then
    run_ps1 pwsh
elif command -v pwsh.exe >/dev/null 2>&1; then
    run_ps1 pwsh.exe
elif command -v powershell.exe >/dev/null 2>&1; then
    gpath=$(cygpath -w "$guard" 2>/dev/null || echo "$guard")
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$gpath" -Hook pre-push </dev/null || exit 1
else
    sh "$DIR/branch-location-guard.sh" || exit 1
fi
exit 0
