# Vendored from RichardvZyl/engineering-standards. Read-only downstream.
# A local edit is drift the weekly sync will fight. Disagree? Change it upstream.

root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = false
trim_trailing_whitespace = true

[*.{md,markdown}]
trim_trailing_whitespace = false   # two trailing spaces are a hard line break

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{csproj,vbproj,props,targets,config,nuspec,resx}]
indent_size = 2

[*.sh]
end_of_line = lf

[*.cs]

#### Usings ####

# System.* first, then the rest, alphabetised, no blank groups.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# An unnecessary using is a compile-time signal, not a style preference.
dotnet_diagnostic.IDE0005.severity = warning

#### Language conventions ####

csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

#### Naming ####

dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_pascal
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_pascal.required_prefix = I
dotnet_naming_style.prefix_i_pascal.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = prefix_underscore_camel
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.prefix_underscore_camel.required_prefix = _
dotnet_naming_style.prefix_underscore_camel.capitalization = camel_case

#### Correctness analysers that earn their noise ####

# ConfigureAwait(false) in library code.
dotnet_diagnostic.CA2007.severity = warning
# Do not await a void-returning method / async void.
dotnet_diagnostic.CS4014.severity = error
# Pass CancellationToken through.
dotnet_diagnostic.CA2016.severity = warning
# Do not use string interpolation to build SQL.
dotnet_diagnostic.CA2100.severity = error
# Specify CultureInfo / StringComparison explicitly.
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1309.severity = warning
# Dispose of disposables.
dotnet_diagnostic.CA2000.severity = warning

[*.sql]
indent_size = 4
trim_trailing_whitespace = true